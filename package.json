{
	"name": "workers-email-archiver",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"tail": "wrangler tail",
		"login": "wrangler login",
		"logout": "wrangler logout",
		"whoami": "wrangler whoami",
		"test": "npm run test:unit && npm run test:runtime",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:check": "wrangler deploy --dry-run",
		"ci": "npm run format:check && npm run typecheck && npm run test:coverage && npm run test:runtime && npm run build:check",
		"test:unit": "vitest run",
		"test:runtime": "vitest run --config vitest.workers.config.mts"
	},
	"dependencies": {
		"aws4fetch": "^1.0.20"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.2",
		"@cloudflare/workers-types": "^5.20261114.1",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^4.1.12",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.162.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	}
}
